# Copy this file to .env and fill in your own keys. Never commit .env.
# apilayer IPstack (approximate visitor location): https://ipstack.com
IPSTACK_KEY=
# apilayer Weatherstack (current weather): https://weatherstack.com
WEATHERSTACK_KEY=
# NASA FIRMS MAP_KEY (fire detections): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Optional
# PORT=3000
# WEATHERSTACK_DAILY_LIMIT=3
# IPSTACK_DAILY_LIMIT=3
# API_RATE_LIMIT=300
